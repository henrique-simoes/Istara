# Istara testing Caddyfile — mirrors the production Caddyfile routing
# (see Caddyfile at repo root) but listens on plain HTTP :80 for IP-based
# acceptance testing on the managed VPS. Production uses TLS + a domain via
# the root Caddyfile. Same-origin: the browser only ever talks to :13080.

:80 {
    # Backend API
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Webhook routes (WhatsApp, Google Chat, survey platforms)
    handle /webhooks/* {
        reverse_proxy backend:8000
    }

    # MCP endpoint (when enabled)
    handle /mcp/* {
        reverse_proxy backend:8000
    }

    # WebSocket endpoints
    handle /ws/* {
        reverse_proxy backend:8000
    }

    # A2A Protocol discovery
    handle /a2a {
        reverse_proxy backend:8000
    }

    handle /.well-known/* {
        reverse_proxy backend:8000
    }

    # Frontend (catch-all)
    handle {
        reverse_proxy frontend:3000
    }
}
